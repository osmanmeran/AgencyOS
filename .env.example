# Environment Configuration
NODE_ENV=development
PORT=3001
BIND_ADDRESS=127.0.0.1

# JWT Secret (auto-generated if not set, but should be set for production)
JWT_SECRET=your-secret-key-change-in-production

# Microsoft OAuth Configuration (REQUIRED FOR SSO)
# Get these from Azure Portal > App registrations > Your App
VITE_MICROSOFT_CLIENT_ID=your-client-id-from-azure
MICROSOFT_CLIENT_ID=your-client-id-from-azure
VITE_MICROSOFT_TENANT=common
MICROSOFT_TENANT=common
# Set this to your production domain in Vercel environment
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/mock-login

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# SSL Configuration (optional, for HTTPS)
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CERT_PATH=/path/to/cert.pem

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Logging Configuration (optional)
# LOG_LEVEL=debug # Set to 'debug' for OAuth troubleshooting

# Vercel specific (set automatically on Vercel)
# VERCEL=true
