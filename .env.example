# Environment Configuration
NODE_ENV=development
PORT=3001
BIND_ADDRESS=127.0.0.1

# JWT Secret (auto-generated if not set, but should be set for production)
JWT_SECRET=your-secret-key-change-in-production

# Encryption key for secrets stored at rest (e.g. each tenant's own Stripe API
# key — see server/lib/encryption.js). 64 hex characters (32 bytes), e.g.
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Auto-generated if unset, but MUST be set (and never rotated/lost) in
# production: anything encrypted under a since-discarded key becomes
# permanently undecryptable, requiring the workspace to re-enter its Stripe key.
ENCRYPTION_KEY=

# Auth token lifetimes. Access tokens are short-lived and rotated transparently
# via the refresh-token cookie (see server/services/auth.js). Defaults: 15m
# access, 30d refresh.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Microsoft OAuth Configuration (OPTIONAL)
# Get these from Azure Portal > App registrations > Your App
# Redirect URI to register in Azure: https://yourdomain.com/auth/microsoft/callback
VITE_MICROSOFT_CLIENT_ID=your-client-id-from-azure
MICROSOFT_CLIENT_ID=your-client-id-from-azure
VITE_MICROSOFT_TENANT_ID=your-tenant-id-from-azure
MICROSOFT_TENANT_ID=your-tenant-id-from-azure

# Google OAuth Configuration (OPTIONAL)
# Get these from Google Cloud Console > Credentials
# Redirect URI to register in Google Console: https://yourdomain.com/auth/microsoft/callback
VITE_GOOGLE_CLIENT_ID=your-client-id-from-google
GOOGLE_CLIENT_ID=your-client-id-from-google

# OCR feature (OPTIONAL, OFF by default)
# The /api/integrations/ocr/* endpoints shell out to server/ocr_parse.py, which
# requires python3, pytesseract and pdf2image to be installed on the host.
# Leave unset (disabled) unless those system deps are provisioned.
OCR_ENABLED=false

# Yelp Fusion API key (OPTIONAL) — enables the supplier "Search Web" Yelp
# source (phone, rating, reviews, categories). Get a free key at
# https://docs.developer.yelp.com/docs/fusion-intro (free tier: 5,000 calls/day).
# If unset, the search skips Yelp and uses the other (key-less) sources.
YELP_API_KEY=

# Online payments need NO env vars here at all — each workspace brings its own
# Stripe secret key + webhook secret, pasted directly into Settings →
# Integrations → Payments (see server/services/stripeSettings.js). Nothing to
# configure at the hosting level for a new workspace to start accepting
# payments.

# App URL (used for invite links and email callbacks)
APP_URL=http://localhost:5173

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# SSL Configuration (optional, for HTTPS)
# SSL_KEY_PATH=/path/to/key.pem
# SSL_CERT_PATH=/path/to/cert.pem

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Logging Configuration (optional)
# LOG_LEVEL=debug # Set to 'debug' for OAuth troubleshooting

# --- Multi-tenant SaaS -------------------------------------------------------

# Comma-separated allow-list of emails granted cross-tenant /api/platform/*
# access (the tenant registry, off-box backup health, etc). Distinct from the
# per-workspace `admin` tier, which has no cross-tenant access. Leave unset to
# disable platform admin entirely.
PLATFORM_ADMIN_EMAILS=

# Root domain used to resolve a tenant from the Host subdomain (e.g.
# "marvelops.app" so "acme.marvelops.app" resolves to tenant "acme"). Leave
# unset for single-domain mode, where the tenant is instead resolved from the
# active_tenant cookie.
APP_ROOT_DOMAIN=

# Set to 'true' to allow self-serve workspace creation via POST
# /api/tenants/signup. Defaults to disabled.
ALLOW_PUBLIC_SIGNUP=false

# Trial length (days) applied to a self-service-signup workspace. Defaults to
# a fixed fallback in server/services/tenants.js if unset/invalid.
TRIAL_DAYS=14

# Where per-tenant SQLite files and the platform registry DB live. Defaults to
# ./data. On Railway, point this at the persistent volume's mount path.
DATA_DIR=

# --- Off-box backups (OPTIONAL) ----------------------------------------------
# Fan out createBackupSync snapshots per tenant to S3-compatible storage (see
# server/services/offsiteBackup.js). Off entirely unless BUCKET + both keys
# are set.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible providers (e.g. Cloudflare R2).
BACKUP_S3_ENDPOINT=
# Comma-separated emails to notify on backup failure. Falls back to
# PLATFORM_ADMIN_EMAILS if unset.
BACKUP_ALERT_EMAIL=

# Default "From" address for outbound email. Falls back to SMTP_USER, then a
# hardcoded default, if unset.
SMTP_FROM=
