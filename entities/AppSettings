{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "default": "TravelPro"
    },
    "logo_url": {
      "type": "string"
    },
    "default_language": {
      "type": "string",
      "default": "en"
    },
    "reference_format": {
      "type": "object",
      "properties": {
        "include_department": {
          "type": "boolean",
          "default": true
        },
        "include_category": {
          "type": "boolean",
          "default": true
        },
        "include_year": {
          "type": "boolean",
          "default": true
        },
        "include_client": {
          "type": "boolean",
          "default": false
        },
        "prefix": {
          "type": "string",
          "default": "TRP"
        }
      }
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_templates": {
      "type": "array",
      "description": "Overrides server/services/tasks.js's DEFAULT_TASK_TEMPLATES for auto-generated booking tasks. Empty/absent falls back to the built-in defaults; a non-empty list fully replaces them (no merge).",
      "items": {
        "type": "object",
        "properties": {
          "template_key": { "type": "string", "description": "Stable key; changing it orphans previously-generated tasks" },
          "title": { "type": "string" },
          "anchor": { "type": "string", "enum": ["created_date", "start_date", "end_date"], "default": "start_date" },
          "offsetDays": { "type": "number", "description": "Signed days from the anchor date: negative = before, positive = after" },
          "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "department": { "type": "string", "description": "Restrict to one AppSettings.departments value; '' = all departments" },
          "description": { "type": "string", "description": "May use {client_name} {destination} {start_date} {end_date} {reference_number} placeholders" }
        }
      }
    },
    "invoice_header": {
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string"
        },
        "address_line1": {
          "type": "string"
        },
        "address_line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "tax_id": {
          "type": "string"
        },
        "bank_details": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        }
      },
      "description": "Company header info for invoices"
    },
    "default_payment_terms": {
      "type": "string",
      "default": "Due within 30 days"
    },
    "default_invoice_notes": {
      "type": "string"
    },
    "setup_wizard_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether an admin has dismissed the Dashboard's \"finish setting up your workspace\" banner"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_tier": {
          "$in": ["admin", "manager", "accounting"]
        }
      }
    },
    "update": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    },
    "write": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    }
  }
}