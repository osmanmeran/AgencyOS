{
  "name": "ProposalTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "destination": {
      "type": "string"
    },
    "duration_days": {
      "type": "number",
      "description": "Typical trip duration in days"
    },
    "notes": {
      "type": "string"
    },
    "terms_and_conditions": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "description": "Pre-filled services with pricing",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "acquiring_price": {
            "type": "number"
          },
          "selling_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "acquiring_currency": {
      "type": "string",
      "default": "USD"
    },
    "selling_currency": {
      "type": "string",
      "default": "USD"
    },
    "source_trip_id": {
      "type": "string",
      "description": "Trip this template was created from"
    },
    "source_trip_name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}