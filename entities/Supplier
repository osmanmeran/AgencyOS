{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier name"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "City where the supplier is located"
    },
    "area": {
      "type": "string",
      "description": "Area or region of operation"
    },
    "pricing_info": {
      "type": "string",
      "description": "Pricing details and packages"
    },
    "notes": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "show_in_portal": {
      "type": "boolean",
      "default": false,
      "description": "When true, the supplier is published to the client travel shop (only its approved SupplierPricing services are shown)"
    },
    "car_rental_terms": {
      "type": "string",
      "description": "Terms and conditions for car rental suppliers"
    },
    "car_rental_locations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Available pickup/dropoff locations for this car rental supplier"
    },
    "custom_fields": {
      "type": "object",
      "description": "Extra admin-defined fields as key-value pairs"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.linked_supplier_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.linked_supplier_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    }
  }
}