{
  "name": "SupplierInvoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string"
    },
    "trip_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "submitted"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "amount",
    "issue_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent",
                "accounting"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    }
  }
}