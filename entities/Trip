{
  "name": "Trip",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Unique reference number"
    },
    "client_id": {
      "type": "string",
      "description": "Linked client ID"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Trip name"
    },
    "destination": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "planning"
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "confirmed",
        "rejected"
      ],
      "default": "pending",
      "description": "Client-facing proposal/confirmation status"
    },
    "passengers": {
      "type": "array",
      "description": "List of passengers",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_contact": {
            "type": "boolean",
            "default": false
          },
          "room_with": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "description": "Services included in this reservation/proposal",
      "items": {
        "type": "object",
        "properties": {
          "_key": {
            "type": "string"
          },
          "supplier_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Service category (hotel, transfer, activity, etc)"
          },
          "location": {
            "type": "string",
            "description": "Location where service is provided"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Service start date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Service end date"
          },
          "unit": {
            "type": "string",
            "enum": [
              "per_person",
              "per_night",
              "per_day",
              "flat_rate",
              "per_hour"
            ],
            "default": "per_person",
            "description": "Unit of measurement for pricing"
          },
          "quantity": {
            "type": "number"
          },
          "acquiring_price": {
            "type": "number",
            "description": "Supplier cost per unit"
          },
          "supplier_currency": {
            "type": "string",
            "default": "USD",
            "description": "Supplier side currency"
          },
          "selling_price": {
            "type": "number",
            "description": "Client price per unit"
          },
          "client_currency": {
            "type": "string",
            "default": "USD",
            "description": "Client side currency"
          },
          "pricing_id": {
            "type": "string"
          },
          "booking_source": {
            "type": "string",
            "enum": ["direct", "via_supplier"],
            "default": "direct",
            "description": "Whether booked directly or via another supplier"
          }
        }
      }
    },
    "acquiring_currency": {
      "type": "string",
      "default": "USD"
    },
    "selling_currency": {
      "type": "string",
      "default": "USD"
    },
    "exchange_rate": {
      "type": "number",
      "default": 1
    },
    "markup_percentage": {
      "type": "number",
      "default": 0
    },
    "total_cost": {
      "type": "number"
    },
    "total_expenses": {
      "type": "number",
      "default": 0
    },
    "final_price": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal notes visible only to staff, not to clients"
    },
    "terms_and_conditions": {
      "type": "string"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string"
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "previous_status": {
            "type": "string"
          },
          "new_status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "destination",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}