{
  "name": "Message",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Client who sent/received message"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "client",
        "agent"
      ],
      "description": "Who sent the message"
    },
    "sender_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "proposal",
        "invoice",
        "trip",
        "general"
      ],
      "default": "general"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of related proposal/invoice/trip"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "sender_type",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent",
            "user"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    }
  }
}