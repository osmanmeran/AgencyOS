{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Client this quote was requested by"
    },
    "client_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Quote / package title"
    },
    "destination": {
      "type": "string",
      "description": "Trip destination (reservation-style builder)"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "passengers": {
      "type": "array",
      "description": "Passenger anagraphics + rooming, entered by the client in the quote builder",
      "items": { "type": "object" }
    },
    "items": {
      "type": "array",
      "description": "Selected supplier pricing lines with computed client sell price",
      "items": {
        "type": "object",
        "properties": {
          "pricing_id": {
            "type": "string"
          },
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "description": "Display currency of unit_price/line_total (client's preferred_currency)"
          },
          "original_currency": {
            "type": "string",
            "description": "Supplier currency the price was converted from"
          },
          "exchange_rate": {
            "type": "number",
            "description": "Frozen original_currency -> currency rate used at submit time"
          },
          "unit_price": {
            "type": "number",
            "description": "Client sell price per unit, markup applied and converted to the display currency"
          },
          "quantity": {
            "type": "number"
          },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "nights": { "type": "number" },
          "room_type": { "type": "string" },
          "pickup_location": { "type": "string" },
          "dropoff_location": { "type": "string" },
          "flight_number": { "type": "string" },
          "service_time": { "type": "string" },
          "details": { "type": "string", "description": "Free-text client detail/notes for this line" },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "markup_percentage": {
      "type": "number",
      "description": "Client's default markup % applied when this quote was computed"
    },
    "subtotal": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewing",
        "quoted",
        "accepted",
        "declined"
      ],
      "default": "submitted"
    },
    "notes": {
      "type": "string"
    },
    "requested_by": {
      "type": "string",
      "description": "User id of the client-portal user who submitted this quote request"
    },
    "response_notes": {
      "type": "string",
      "description": "Staff notes shown back to the client when the request is reviewed"
    },
    "responded_by": {
      "type": "string",
      "description": "User id of the staff member who last changed the status"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time"
    },
    "converted_trip_id": {
      "type": "string",
      "description": "Set once this quote has been converted into a Trip; prevents duplicate conversion"
    },
    "trip_id": {
      "type": "string",
      "description": "Set by the client at submission time if they attached this request to one of their own existing upcoming trips, instead of it being a standalone request. Ownership is re-checked server-side."
    }
  },
  "required": [
    "client_id",
    "title",
    "items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        },
        {
          "data.client_id": "{{user.client_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        },
        {
          "data.client_id": "{{user.client_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}
