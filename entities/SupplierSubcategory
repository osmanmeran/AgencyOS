{
  "name": "SupplierSubcategory",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "description": "Parent supplier ID"
    },
    "name": {
      "type": "string",
      "description": "Subcategory name (e.g., Economy, Business, Deluxe)"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "supplier_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        },
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager",
                "agent"
              ]
            }
          }
        },
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        },
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_tier": "admin"
      }
    }
  }
}