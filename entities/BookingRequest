{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Unique booking reference"
    },
    "trip_id": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "service_details": {
      "type": "string"
    },
    "num_guests": {
      "type": "number",
      "default": 1
    },
    "total_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "supplier_confirmed": {
      "type": "boolean",
      "default": false
    },
    "confirmation_file_url": {
      "type": "string",
      "description": "Uploaded confirmation letter/PDF"
    },
    "supplier_notes": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "service_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_tier": {
          "$in": [
            "admin",
            "manager",
            "agent"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.supplier_id": "{{user.linked_supplier_id}}"
        },
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.supplier_id": "{{user.linked_supplier_id}}"
        },
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_tier": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}