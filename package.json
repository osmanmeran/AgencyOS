{
  "name": "marvelops-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "start": "NODE_ENV=production node server/server.js",
    "prod": "npm run build && npm run db:migrate && npm run seed:tours && NODE_ENV=production node server/server.js",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p ./jsconfig.json",
    "prepare": "husky",
    "preview": "vite preview",
    "db:migrate": "node server/migrations/cli.js up",
    "db:migrate:down": "node server/migrations/cli.js down",
    "db:migrate:status": "node server/migrations/cli.js status",
    "db:migrate:platform": "node server/migrations/cli.js platform",
    "db:migrate:platform:status": "node server/migrations/cli.js platform:status",
    "db:migrate:bootstrap": "node server/migrations/cli.js bootstrap",
    "db:migrate:fleet:status": "node server/migrations/cli.js fleet:status",
    "saas:adopt-tenant-zero": "node scripts/adopt-tenant-zero.mjs",
    "backup:offsite": "node scripts/offsite-backup-cli.mjs",
    "seed:tours": "node scripts/seedItalianDailyTours.mjs && node scripts/localizeItalianTours.mjs",
    "db:backup:list": "node scripts/backup-cli.mjs list",
    "db:backup:restore": "node scripts/backup-cli.mjs restore",
    "openapi": "node scripts/generateOpenApi.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.84.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "compression": "^1.8.1",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.5.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.16.4",
    "helmet": "^8.2.0",
    "input-otp": "^1.4.2",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.475.0",
    "multer": "^2.2.0",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^4.2.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.3",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "src/{components,pages}/**/*.{js,jsx}": [
      "eslint --fix"
    ],
    "src/Layout.jsx": [
      "eslint --fix"
    ],
    "!(package-lock).{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
